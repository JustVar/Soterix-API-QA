# Soterix-API-QA - environment template
# Copy to .env and fill in. Never commit .env (gitignored).
#
# The server, the site name and the camera name live in config/env/qa.py.
# This file holds the account and the optional switches.

# ---------------------------------------------------------------------------
# Required. The account the suite signs in as (tests/internal_api).
# ---------------------------------------------------------------------------
QA_USER=
QA_PASSWORD=

# Optional. Selects config/env/<ENV>.py. Default qa.
ENV=qa

# ---------------------------------------------------------------------------
# Optional. Integration API (/v-integration-api), static key auth.
# The suite in tests/integration_api skips every test while this is empty.
# The key comes from the product: Admin > Integrations > API Integration.
# ---------------------------------------------------------------------------
VSAAS_INTEGRATION_KEY=

# ---------------------------------------------------------------------------
# Optional. QA Touch upload. Used only with:
#   pytest --qatouch-upload --qatouch-run <RUN_KEY>
# ---------------------------------------------------------------------------
QATOUCH_API_KEY=
QATOUCH_DOMAIN=
QATOUCH_PROJECT_ID=

# ---------------------------------------------------------------------------
# Optional tuning. Leave blank for the defaults. The file that reads each
# key is named beside it.
# ---------------------------------------------------------------------------
# TLS. The clients do not verify the server certificate unless this is true
# (api_clients/auth_helper.py, api_clients/base_api_client.py,
# tests/internal_api/test_auth_apis.py). Set true on a server with a
# certificate a public CA signed.
SSL_VERIFY=
# Pin the site the READ-ONLY tests use (tests/internal_api/conftest.py,
# fixture test_site_id). Blank: the first site the account sees. Tests that
# write data ignore this and use test_site_name from config/env/.
TEST_SITE_ID=
# Pin the camera the e2e tests use (tests/internal_api/_support/config.py).
TEST_CHANNEL_ID=
# Request timeout in seconds, default 120 (tests/internal_api/_support/config.py).
API_TIMEOUT_SECONDS=
# Clip export: seconds to wait for the job (default 120) and seconds of
# footage to export (default 60) (tests/internal_api/_support/config.py).
CLIP_EXPORT_TIMEOUT_SECONDS=
CLIP_EXPORT_DURATION_SECONDS=
# Recipient of the media-share e2e step. The test skips while this is
# blank, so no real email is sent (tests/internal_api/_support/config.py).
MEDIA_SHARE_TEST_EMAIL=
# SSO smoke (tests/internal_api/test_auth_apis.py). The test skips while
# blank. The /REST/sso/login contract is unknown, see docs/API_SURFACES.md.
SSO_TEST_USERNAME=
SSO_TEST_PASSWORD=
# RUN_ARCHIVE=off turns off the per-run report under reports/runs/.
RUN_ARCHIVE=
