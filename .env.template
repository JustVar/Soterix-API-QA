# Soterix-API-QA -- environment template
# Copy to .env and fill in. NEVER commit .env (gitignored).
#
# Credential rotation is a TWO-REPO action: rotate here AND in Soterix-WebApp-QA.

# ---------------------------------------------------------------------------
# Per-account passwords. Names must match the 'password_env' keys in
# config/env/{qa,stage,prod}.py. These MUST stay above QA_PASSWORD:
# python-dotenv expands ${VAR} in file order, so referencing a variable defined
# further down resolves to empty and login fails.
# ---------------------------------------------------------------------------
JUSTIN_PASSWORD=
TEST_AUTO_QA_PASSWORD=
QA_LAB_PASSWORD=
HARDWARE_LAB_PASSWORD=
JUSTIN_STAGE_PASSWORD=
JUSTIN_PROD_PASSWORD=

# ---------------------------------------------------------------------------
# ACTIVE ACCOUNT -- what the test suite logs in as (conftest login_data).
# The QA URL serves two different backends depending on the account:
#   qa@soterixsystems.com + ${JUSTIN_PASSWORD} -> 'india' box (populated)
#   qa@soterixsystems.com           + ${QA_LAB_PASSWORD} -> local box (partial)
# ---------------------------------------------------------------------------
QA_USER=qa@soterixsystems.com
QA_PASSWORD=${JUSTIN_PASSWORD}

# Environment selection: qa (default) | stage | prod. Hosts live in config/env/.
ENV=qa

# Known-good site for the justin account (sites: 16, 17, 105, 109, 111).
TEST_SITE_ID=17

# ---------------------------------------------------------------------------
# Integration API (/v-integration-api) -- static key auth, QA only for now.
# See docs/API_SURFACES.md. Leave empty until a key is issued.
# ---------------------------------------------------------------------------
VSAAS_INTEGRATION_KEY=

# ---------------------------------------------------------------------------
# QA Touch result reporting (optional; only used with --qatouch-upload)
# ---------------------------------------------------------------------------
QATOUCH_URL=
QATOUCH_API_KEY=
QATOUCH_DOMAIN=
QATOUCH_PROJECT_ID=
