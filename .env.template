# Soterix-API-QA - environment template
# Copy to .env and fill in. NEVER commit .env (gitignored).
#
# Use your own account. Do not share credentials between people.

# ---------------------------------------------------------------------------
# Your QA account. This is what the suite signs in as by default.
# ---------------------------------------------------------------------------
QA_USER=
QA_PASSWORD=

# Environment selection: qa (default) | stage | prod. Hosts live in config/env/.
ENV=qa

# Optional: pin the site the READ-ONLY smoke tests use (fixture test_site_id).
# Leave blank to let the suite discover one. Tests that WRITE data ignore this
# and resolve their site by name (test_site_name in config/env/, fixture
# data_site_id). A bare number is easy to get wrong: on QA, 17 is
# "Example Corporate Office" and the UI suite's site "Newtown Action
# Area" is 16. If you set it, write the site name next to it.
TEST_SITE_ID=

# ---------------------------------------------------------------------------
# Per-box accounts. Only needed when you set BOX=<name> to target a specific
# box instead of the default. Box names live in config/env/{qa,stage,prod}.py.
# QA testing happens mainly on the india box.
# ---------------------------------------------------------------------------
QA_INDIA_USER=
QA_INDIA_PASSWORD=
QA_US_USER=
QA_US_PASSWORD=
STAGE_USER=
STAGE_PASSWORD=

# Shared Videonetics account (box "videonetics" on qa and stage). Used by
# the team's API flow tests. Ask Justin for the values.
QA_VIDEONETICS_PASSWORD=
STAGE_VIDEONETICS_PASSWORD=

# Shared accounts on the production hosts. Passwords only; the addresses are
# in config/env/prod.py.
HARDWARE_LAB_PASSWORD=
TEST_AUTO_PROD_PASSWORD=

# ---------------------------------------------------------------------------
# Integration API (/v-integration-api) - static key auth, QA only for now.
# Use the QA tenant key named "QA Automation - DO NOT DELETE" (Admin >
# Integrations > API Integration; ask Justin). The suite skips when empty.
# See docs/API_SURFACES.md.
# ---------------------------------------------------------------------------
VSAAS_INTEGRATION_KEY=

# ---------------------------------------------------------------------------
# QA Touch result reporting (optional; only used with --qatouch-upload)
# ---------------------------------------------------------------------------
QATOUCH_URL=
QATOUCH_API_KEY=
QATOUCH_DOMAIN=
QATOUCH_PROJECT_ID=
